{
  "include": [
		"~/.config/waybar/modules/modules.jsonc",
		"~/.config/waybar/modules/custom-modules.jsonc"
	],

  "position": "top",
  "margin-top": 12,
  "modules-left": [
    "custom/launcher"
  ],

  "modules-center": [
    "clock",
    "hyprland/workspaces"
  ],

  "modules-right": [
    "group/tray-drawer",
    "pulseaudio",
    "custom/notification"
  ]
}