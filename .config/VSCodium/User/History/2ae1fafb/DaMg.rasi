/**
 * Wallpapers.rasi - Large Clean Grid Version
 **/

/*****----- Configuration -----*****/
configuration {
    modi:                        "drun";
    show-icons:                  true;
    drun-display-format:         "{name}";
    font:                        "SF Pro Text Medium 12";
}

/*****----- Global Properties -----*****/
@import                        "../colors/colors.rasi"

/*****----- Main Window -----*****/
window {
    transparency:                "real";
    location:                    center;
    anchor:                      center;
    fullscreen:                  false;
    width:                       1500px;  /* Increased from 1100px */
    height:                      420px;   /* Increased from 320px */
    enabled:                     true;
    margin:                      0px;
    padding:                     0px;
    border:                      1px solid;
    border-radius:               24px;
    border-color:                @background-alt;
    background-color:            @background;
    cursor:                      "default";
}

/*****----- Main Box -----*****/
mainbox {
    enabled:                     true;
    spacing:                     0px;
    margin:                      0px;
    padding:                     30px;    /* Increased edge padding */
    background-color:            transparent;
    children:                    [ "listview" ];
}

/*****----- Listview -----*****/
listview {
    enabled:                     true;
    columns:                     4;
    lines:                       1;
    cycle:                       true;
    dynamic:                     true;
    scrollbar:                   false;
    layout:                      vertical;
    reverse:                     false;
    fixed-height:                false;
    fixed-columns:               true;
    spacing:                     30px;    /* Increased space between images */
    background-color:            transparent;
    cursor:                      "default";
}

/*****----- Elements -----*****/
element {
    enabled:                     true;
    padding:                     15px;    /* Increased space inside the selection box */
    border:                      2px solid;
    border-radius:               20px;
    border-color:                transparent;
    background-color:            @background-alt;
    orientation:                 vertical;
    cursor:                      pointer;
}

element selected.normal {
    background-color:            @background-alt;
    text-color:                  @selected;
    border-color:                @selected;
}

element-icon {
    background-color:            transparent;
    size:                        340px;   /* Increased thumbnail size from 250px */
    cursor:                      inherit;
    border-radius:               14px;
}

element-text {
    enabled:                     false;
}